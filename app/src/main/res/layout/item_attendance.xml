<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Subject Title -->
        <TextView
            android:id="@+id/txtSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subject Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_alignParentStart="true" />

        <!-- Start Date -->
        <TextView
            android:id="@+id/txtStartDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start date: 12/05/2025"
            android:textSize="13sp"
            android:layout_below="@id/txtSubject"
            android:layout_marginTop="8dp" />

        <!-- End Date -->
        <TextView
            android:id="@+id/txtEndDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End date: 21/07/2025"
            android:textSize="13sp"
            android:layout_below="@id/txtStartDate"
            android:layout_marginTop="4dp" />

        <!-- Attendance -->
        <TextView
            android:id="@+id/txtAttendance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attended: 8/8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_green_dark"
            android:layout_below="@id/txtEndDate"
            android:layout_marginTop="4dp" />

        <!-- Circular Progress -->
        <com.example.preojt_riskalert_mobile.customviews.CustomProgressView
            android:id="@+id/progressView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>
